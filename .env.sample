# ─── App ─────────────────────────────────────────────────────────────────────
# The canonical public URL of the app (no trailing slash)
# Local: http://localhost:3000 — Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Neon (PostgreSQL) ────────────────────────────────────────────────────────
# Found in: Neon Dashboard → your project → Connection Details (use Pooled connection)
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_SITE_URL — Better Auth uses this to build callback URLs
# Local: http://localhost:3000 — Production: https://stride-web-frontend.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=<random-32-byte-hex-secret>

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<your-google-client-secret>

# ─── Vercel Blob ─────────────────────────────────────────────────────────────
# Found in: Vercel Dashboard → Storage → your Blob store → .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<your-token>

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Bearer token for /api/cron/* routes (inactive-account purge). Must be named
# exactly CRON_SECRET — Vercel attaches it automatically to cron invocations.
# Generate with: openssl rand -hex 32
CRON_SECRET=<random-32-byte-hex-secret>

# ─── Strava ───────────────────────────────────────────────────────────────────
# Found in: Strava Developer Dashboard → your app → Settings → Client ID/Secret
STRIDE_STRAVA_CLIENT_ID=<your-strava-client-id>
STRIDE_STRAVA_CLIENT_SECRET=<your-strava-client-secret>

# ─── Brevo (transactional email) ─────────────────────────────────────────────
# Found in: Brevo Dashboard → Settings → SMTP & API → API Keys (use an API key,
# NOT the SMTP master password). Sender no-reply@mail.strideclub.in must be
# verified via domain authentication (domain: mail.strideclub.in).
# Optional locally — emails are skipped when unset.
STRIDE_BREVO_API_KEY=<your-brevo-v3-api-key>