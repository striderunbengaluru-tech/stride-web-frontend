# ─── App ─────────────────────────────────────────────────────────────────────
# The canonical public URL of the app (no trailing slash)
# Local: http://localhost:3000 — Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Neon (PostgreSQL) ────────────────────────────────────────────────────────
# Found in: Neon Dashboard → your project → Connection Details (use Pooled connection)
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_SITE_URL — Better Auth uses this to build callback URLs
# Local: http://localhost:3000 — Production: https://stride-web-frontend.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=<random-32-byte-hex-secret>

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<your-google-client-secret>

# ─── Vercel Blob ─────────────────────────────────────────────────────────────
# Found in: Vercel Dashboard → Storage → your Blob store → .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<your-token>

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Bearer token for /api/cron/* routes (inactive-account purge). Must be named
# exactly CRON_SECRET — Vercel attaches it automatically to cron invocations.
# Generate with: openssl rand -hex 32
CRON_SECRET=<random-32-byte-hex-secret>

# ─── Strava ───────────────────────────────────────────────────────────────────
# Found in: Strava Developer Dashboard → your app → Settings → Client ID/Secret
STRIDE_STRAVA_CLIENT_ID=<your-strava-client-id>
STRIDE_STRAVA_CLIENT_SECRET=<your-strava-client-secret>

# ─── Brevo (transactional email) ─────────────────────────────────────────────
# Found in: Brevo Dashboard → Settings → SMTP & API → API Keys (use an API key,
# NOT the SMTP master password). Sender no-reply@strideclub.in must be
# verified via domain authentication (domain: strideclub.in).
# Optional locally — emails are skipped when unset.
STRIDE_BREVO_API_KEY=<your-brevo-v3-api-key>
# ─── WalletWallet (Apple/Google Wallet passes) ───────────────────────────────
# Found in: walletwallet.dev dashboard → API Keys. Powers the "Add to Apple/
# Google Wallet" buttons on the booking confirmation page. Free tier allows
# 1000 pass generations/month — the app hides the buttons when the quota is
# exhausted. Optional locally — the wallet CTAs are hidden when unset.
STRIDE_WALLETWALLET_API_KEY=<your-walletwallet-api-key>

# ─── Razorpay (event payments) ───────────────────────────────────────────────
# Found in: Razorpay Dashboard → Account & Settings → API Keys. Use TEST keys
# for local/Preview and LIVE keys only on Production. Powers paid-event
# checkout, server-side payment verification, and the webhook confirm path.
# Key id is publishable (safe in the client bundle); the secret and the webhook
# secret are server-only.
STRIDE_RAZORPAY_KEY_ID=<your-razorpay-key-id>
STRIDE_RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
# Set this to match the secret you configure when creating the webhook in
# Razorpay Dashboard → Settings → Webhooks (endpoint: /api/webhooks/razorpay,
# events: payment.captured, payment.failed).
STRIDE_RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>
# Same value as STRIDE_RAZORPAY_KEY_ID — exposed to the browser for checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=<your-razorpay-key-id>
